# Copy this file to .env and fill in the API key. Never commit .env.

# AI provider for BOTH embeddings and answers: gemini (testing phase) or openai (production).
AI_PROVIDER=gemini

# --- Gemini (testing phase) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-2.5-flash-lite
# Client-side limit on chat-model calls per minute (0 = no limit). 5 keeps the Gemini free tier happy.
LLM_REQUESTS_PER_MINUTE=5

# --- To use OpenAI instead, set these (and re-run ingest): ---
# AI_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini
# LLM_REQUESTS_PER_MINUTE=0
OPENAI_API_KEY=

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ragdb
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Optional settings (defaults shown)
COLLECTION_NAME=rag_documents
TOP_K=4
PDF_DIR=data/pdfs

# HTTP API. Set SERVICE_API_KEY whenever the API is reachable from outside your machine;
# callers then send the header  X-API-Key: <value>
SERVICE_API_KEY=
MAX_UPLOAD_MB=20
